# WEAVE CBT application image published by GitHub Actions.
# deployment-test is the temporary tag used while validating this branch.
WEAVE_IMAGE=ghcr.io/aphrodite1818/weave-cbt-module:deployment-test

# Local PostgreSQL database settings.
POSTGRES_USER=weave
POSTGRES_PASSWORD=change-this-to-a-long-random-alphanumeric-password
POSTGRES_DB=weave_cbt
