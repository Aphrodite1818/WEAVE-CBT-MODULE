# Existing stable WEAVE CBT image. Installer builds pin this value in build metadata.
WEAVE_IMAGE=ghcr.io/aphrodite1818/weave-cbt-module:sha-7604735

# Local PostgreSQL settings.
POSTGRES_USER=weave
POSTGRES_PASSWORD=change-this-to-a-long-random-alphanumeric-password
POSTGRES_DB=weave_cbt

# Runtime values normally generated by the WEAVE CBT Manager.
ENVIRONMENT=prod
WEAVE_API_BASE_URL=https://api.weavecloudspace.com
DATABASE_URL=postgresql+asyncpg://weave:change-this-to-a-long-random-alphanumeric-password@postgres:5432/weave_cbt
REDIS_URL=redis://redis:6379/0
DEBUG=false
